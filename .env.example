# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # la "secret key" (o la service_role antigua). SOLO servidor.

# URL pública del sitio (la usan los QR). En Vercel es opcional: si no la pones, usa la del proyecto.
# Ponla si conectas un dominio propio, ANTES de imprimir los carteles.
# NEXT_PUBLIC_SITE_URL=https://sorteo.technocell.com

# Panel admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-larga
SESSION_SECRET=otra-cadena-aleatoria-de-32-caracteres-o-mas

# Zona horaria usada para "una vez por tienda al día"
RAFFLE_TZ=America/Caracas
